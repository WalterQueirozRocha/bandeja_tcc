# Banco local (docker compose up -d). Troque SENHA.
POSTGRES_USER=bandeja
POSTGRES_PASSWORD=SENHA
POSTGRES_DB=bandeja
DATABASE_URL="postgresql://bandeja:SENHA@localhost:5433/bandeja?schema=public"
# Banco dos testes de integração (criar uma vez: docker exec bandeja-db createdb -U bandeja bandeja_teste)
DATABASE_URL_TESTE="postgresql://bandeja:SENHA@localhost:5433/bandeja_teste?schema=public"
# Segredo do JWT: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SEGREDO=TROQUE
# E-mail (Resend). Sem a chave, os e-mails ficam numa caixa em memória e aparecem no console.
# RESEND_API_KEY=re_...
# RESEND_REMETENTE="Bandeja <onboarding@resend.dev>"
