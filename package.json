{
  "name": "bandeja",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @bandeja/web",
    "build": "npm run build -w @bandeja/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run test:e2e -w @bandeja/web",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "npm run seed -w @bandeja/dados",
    "importar": "npm run importar -w @bandeja/dados --",
    "avaliar": "npm run avaliar -w @bandeja/web --"
  },
  "devDependencies": {
    "prisma": "7.10.1",
    "typescript": "^5"
  }
}
